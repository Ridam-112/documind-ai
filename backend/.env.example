# DocuMind AI Backend Configuration

# Database (PostgreSQL with pgvector or SQLite for local dev)
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/documind
# DATABASE_URL=sqlite:///./documind.db

# Security
JWT_SECRET=super-secret-jwt-key-replace-with-secure-random-value-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Configuration (LLM)
# Options: groq, openai, gemini, mock
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# AI Configuration (Embedding)
# Options: openai, gemini, local, mock
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# RAG & Chunking Settings
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
RETRIEVAL_TOP_K=5

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
